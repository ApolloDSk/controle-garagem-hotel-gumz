{
  "name": "controle-garagem-hotel-gumz",
  "version": "1.0.0",
  "description": "Controle de Garagem — Hotel Gumz",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "setup": "node setup.js",
    "build": "electron-builder --win --x64",
    "build-portable": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.hotelgumz.garagem",
    "productName": "Controle de Garagem",
    "copyright": "Hotel Gumz",
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerHeaderIcon": "icon.png",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Controle de Garagem"
    },
    "files": [
      "main.js",
      "index.html",
      "pdfjs/**",
      "icon.png"
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
